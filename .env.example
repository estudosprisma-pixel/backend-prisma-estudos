NODE_ENV=production
PORT=3001

CORS_ORIGIN=https://frontend-prismaestudos.pages.dev

# Conexao direta com o Postgres do Supabase (Project Settings -> Database -> Connection string).
# Use a connection string "Session pooler" ou a direta; ambas funcionam com o driver pg.
DATABASE_URL=

# Project Settings -> API no painel do Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AUTO_SEED=false

# Senhas dos administradores fixos criados no boot (ensureRequiredAdmins) e usados pelo seed.
# Os hashes bcrypt antigos nao migram para o Supabase Auth - defina senhas novas aqui antes de
# rodar em qualquer ambiente real.
ADMIN_NAT_PASSWORD=
ADMIN_JOAO_PASSWORD=
ADMIN_PASSWORD=
